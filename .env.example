# =============================================================
# n8n Core
# =============================================================
N8N_ENCRYPTION_KEY=                        # openssl rand -hex 32
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
N8N_SECURE_COOKIE=false

# =============================================================
# DuckDNS — публичный URL n8n (нужен для Telegram Webhook)
# Формат: https://ВАШ_СУБДОМЕН.duckdns.org
# Зарегистрируй бесплатный домен на https://www.duckdns.org
# =============================================================
WEBHOOK_URL=https://YOUR_SUBDOMAIN.duckdns.org

# =============================================================
# Telegram Bot
# Получи токен у @BotFather → /newbot
# НИКОГДА не коммить реальный токен в git
# =============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================
# Bitrix24 Webhook
# Приложения → Вебхуки → Входящий вебхук → Добавить
# Права: tasks, sonet_group
# Формат: https://ВАШ_ДОМЕН.bitrix24.ru/rest/USER_ID/TOKEN/
# =============================================================
BITRIX24_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/YOUR_WEBHOOK_TOKEN/
